# ==========================================
# VIBE CODED APPS - ENVIRONMENT TEMPLATE
# ==========================================

# Network & Host Binding
HOST_HTTP_PORT=8088
HOST_HTTPS_PORT=8443

# General
NODE_ENV=development
APP_URL=http://localhost:8088

# Supabase Database (PostgreSQL)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_PORT=5432

# Supabase Auth (GoTrue)
JWT_SECRET=replace_with_32char_jwt_secret
ANON_KEY=replace_with_anon_key
SERVICE_ROLE_KEY=replace_with_service_key

# OAuth Providers (Google & GitHub)
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=your_google_client_id
GOTRUE_EXTERNAL_GOOGLE_SECRET=your_google_client_secret
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=http://localhost:8088/auth/v1/callback

GOTRUE_EXTERNAL_GITHUB_ENABLED=true
GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=your_github_client_id
GOTRUE_EXTERNAL_GITHUB_SECRET=your_github_client_secret
GOTRUE_EXTERNAL_GITHUB_REDIRECT_URI=http://localhost:8088/auth/v1/callback

# Strix AI Pentest Agent Settings
STRIX_TARGET_URL=http://vibe-nginx:80
STRIX_LLM=gemini/gemini-2.5-pro
STRIX_LLM_API_KEY=your_key_here
